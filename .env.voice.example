# AI dimaag (Aanya ki baat-cheet + call summary). Pehle se daali hai to dobara nahi.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Sirf asli phone call ke liye (Exotel account ke baad) — khali chhodo to manual/browser demo mode
EXOTEL_SID=
EXOTEL_KEY=
EXOTEL_TOKEN=
EXOTEL_FROM=
# EXOTEL_SUBDOMAIN=api.exotel.com
# EXOTEL_FLOW_URL=http://my.exotel.com/<sid>/exoml/start_voice/<flow_id>

# Custom / cloned ladki ki awaaz (ElevenLabs). Khali = browser ki inbuilt awaaz.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
